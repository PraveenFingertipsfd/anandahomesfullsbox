<aura:component controller="GRE_Lead_Controller" implements="force:appHostable,flexipage:availableForAllPageTypes,flexipage:availableForRecordHome,forceCommunity:availableForAllPageTypes,force:lightningQuickActionWithoutHeader" access="global" >
    
    <aura:attribute name="leads" type="Lead__c[]"/>
    <aura:attribute name="searchValue" type="String" default="sales" />
    <aura:attribute name="newLeadForm" type="boolean" default="false"/>
    <aura:attribute name="sectionLabels" type="Map" default=""/>
    <aura:attribute name="selectedCountry" type="string" />
    <aura:attribute name="selectedCountryCode" type="string" />
    <aura:attribute name="recordId" type="string"/>
    <aura:attribute name="newNote" type="string"/>
    <aura:attribute name="selectedLead" type="Lead__c"/>
    <aura:attribute name="isModalOpen" type="boolean" default="true"/>
    <aura:attribute name="isSelectedLead" type="boolean" default="false"/>
    <aura:attribute name="spinner" type="boolean" default="false"/>
    <aura:attribute name="showError" type="boolean" default="false"/>
    <aura:attribute name="hideProjectName" type="boolean" default="true "/>
    <aura:attribute name="accounts" type="String[]" default="[]"/>
    <aura:attribute name="searchText" type="string" default=""/>
    <aura:attribute name="matchaccounts" type="String[]" default="[]"/>
    <aura:attribute name="allocatedProject" type="String"/>
    <aura:attribute name="ratePerSqFeet" type="Decimal"/>
    <aura:attribute name="plotSize" type="Decimal"/>
    <aura:attribute name="leadSource" type="String"/>
    <aura:attribute name="recordTypeId" type="String"/>
    <aura:attribute name="isChannelPartner" type="boolean"/>
    <aura:attribute name="basicprice" type="Decimal"/>
    <aura:attribute name="userId" type="String"/>
    <aura:attribute name="isSubmitting" type="boolean" default="false"/>
    <aura:attribute name="options" type="List" />
    <aura:attribute name="selectedUserValue" type="String" />
    <aura:attribute name="selectedHandleByUserValue" type="String" />
    <aura:attribute name="checkInDateTime" type="String" />
    <aura:attribute name="checkOutDateTime" type="String" />
    <aura:attribute name="Remark" type="String" />
    <aura:attribute name="scheduledSiteVisit" type="Object" />
    <aura:attribute name="selectedLeadId" type="String" />
    <aura:attribute name="selectedLeadProject" type="String"/>
    <aura:attribute name="recordTypeName" type="String" />
    
    <aura:attribute name="siteVisitInProgress" type="Boolean" default="false" />
    
    <aura:attribute name="siteVisits" type="List" />
    <aura:attribute name="groupedProjects" type="Map" />
    <aura:attribute name="groupedStatus" type="Map" />
    
    <aura:attribute name="isFromExistingSV" type="Boolean" default="false"/>
    <aura:attribute name="isSVCompModalOpen" type="Boolean" default="false"/>
    <aura:attribute name="projectUserMap" type="Map"/>
    <aura:attribute name="newSiteVisit" type="Object" default="{'sobjectType':'Site_Visit__c'}"/>
    <aura:attribute name="handledByOptions" type="List"/>
    <aura:attribute name="projectOptions" type="List"/>
    <aura:attribute name="salesRecordTypeId" type="String" />
    <aura:attribute name="newRelatedSource" type="Object" default="{'sobjectType':'Related_Source__c'}"/>
    

    <aura:attribute name="isGREUser" type="Boolean" default="false"/>
    <aura:attribute name="currentUserProfile" type="String"/>
    <aura:attribute name="currentUserProject" type="String"/>
    
    <aura:attribute name="isCheckoutModalOpen" type="Boolean" default="false"/>
    <aura:attribute name="checkoutSVId" type="String"/>
    <aura:attribute name="checkoutTime" type="Datetime"/>
    <aura:attribute name="svVisitType" type="String" default=""/>
    <aura:attribute name="svVisitSourceType" type="String" default=""/>
    <aura:attribute name="svChannelPartnerId" type="String" default=""/>
    
    <!-- karthik 18-02-26 //For round robin toggle-->
    <aura:attribute name="useRoundRobin" type="Boolean" default="true"/>

    <!-- Channel Partner lookup for WALKIN - CP -->
    <aura:attribute name="isWalkinCP" type="Boolean" default="false"/>
    <aura:attribute name="selectedCPId" type="String"/>

    <aura:handler name="init" value="{!this}" action="{!c.doInit}"/>

    
    <lightning:card>
        <div class="slds-modal__header slds-grid slds-grid_align-spread slds-grid_vertical-align-center">
            <h2 id="header43" class="slds-text-heading_medium">GRE Leads</h2>
            <div class="slds-app-launcher__header-search">
                <div class="slds-form-element">
                    <label for="app-launcher-search" class="slds-form-element__label slds-assistive-text">GRE Leads</label>
                    <aura:if isTrue="{!v.isSelectedLead == false}">
                        <div class="slds-form-element__control slds-input-has-icon slds-input-has-icon_left">
                            <!-- Use lightning:icon instead of the <use> tag -->
                            <div class="zindex">
                                <lightning:input aura:id="enter-search" name="enter-search" placeholder="Type Lead Phone and enter" type="search" onchange="{!c.getLeads}" />
                            </div>
                        </div>
                    </aura:if>
                </div>
            </div>
            <aura:if isTrue="{!v.isSelectedLead == false}">
                <button class="slds-button slds-button_neutral" onclick="{!c.toggleNewLead}">New Lead</button>
            </aura:if>
        </div>
        
        <div class=" slds-app-launcher__content" id="modal-content-id-1">
            
            <aura:if isTrue="{!v.isSelectedLead == false}">
                <div class="slds-p-around_medium">
                    <table class="slds-table slds-table_cell-buffer slds-table_bordered slds-table_col-bordered" aria-label="Example table of Leads with vertical borders">
                        <thead>
                            <tr class="slds-line-height_reset">
                                <th scope="col">
                                    <div class="slds-truncate" title="Lead Name">Lead Name</div>
                                </th>
                                <th scope="col">
                                    <div class="slds-truncate" title="Company">Project Name</div>
                                </th>
                                <th scope="col">
                                    <div class="slds-truncate" title="Phone">Phone</div>
                                </th>
                                <th scope="col">
                                    <div class="slds-truncate" title="Phone">Secondary Phone</div>
                                </th>
                                <th scope="col">
                                    <div class="slds-truncate" title="Email">Email</div>
                                </th>
                                <!--
                                <th scope="col">
                                    <div class="slds-truncate" title="Lead Source">Source Type</div>
                                </th>
                                -->
                                <th scope="col">
                                    <div class="slds-truncate" title="Created Date">Created Date</div>
                                </th>
                                <th scope="col">
                                    <div class="slds-truncate" title="Lead Owner">Lead Owner</div>
                                </th>
                                <th scope="col">
                                    <div class="slds-truncate" title="Lead Status">Lead Status</div>
                                </th>
                            </tr>
                        </thead>
                        <tbody>
                            <aura:if isTrue="{!v.leads.length > 0}">  
                                <!-- Loop over the leads -->
                                <aura:iteration items="{!v.leads}" var="lead">
                                    <tr name="{!lead}" onclick="{!c.onSelectLead}">
                                        <th data-label="Lead Name" scope="row">
                                            <div class="slds-truncate" title="{!lead.Name__c}" >
                                                {!lead.Name__c}
                                            </div>
                                        </th>
                                        <td data-label="Company">
                                            <div class="slds-truncate" title="{!lead.Allocated_Project__c}">{!lead.Allocated_Project__c}</div>
                                        </td>
                                        <td data-label="Phone">
                                            <div class="slds-truncate" title="{!lead.Phone__c}">{!lead.Phone__c}</div>
                                        </td>
                                        <td data-label="Secondary Phone">
                                            <div class="slds-truncate" title="{!lead.Phone__c}">{!lead.Secondary_Phone__c}</div>
                                        </td>
                                        <td data-label="Email">
                                            <div class="slds-truncate" title="{!lead.Email}">
                                                {!lead.Email__c}
                                            </div>
                                        </td>
                                        <!--
                                        <td data-label="Lead Source">
                                            <div class="slds-truncate" title="{!lead.Source_Type__c}">{!lead.Source_Type__c}</div>
                                        </td>
                                        -->
                                        <td data-label="Created Date">
                                            <div class="slds-truncate" title="{!lead.formattedCreatedDate}">{!lead.formattedCreatedDate}</div>
                                        </td>
                                        <td data-label="Lead Owner">
                                            <div class="slds-truncate" title="{!lead.Name__c}">{!lead.Lead_Owner_Full_Name__c}</div>
                                        </td>
                                        <td data-label="Lead Status">
                                            <div class="slds-truncate" title="{!lead.Lead_Status__c}">{!lead.Lead_Status__c}</div>
                                        </td>
                                    </tr>
                                </aura:iteration>
                                <aura:set attribute="else">
                                    <p class="slds-p-horizontal_small">
                                        No lead records found
                                    </p>
                                </aura:set>
                            </aura:if>
                        </tbody>
                    </table>
                </div>
            </aura:if>
            <aura:if isTrue="{!v.isSelectedLead == true}">
                        <div class="custom-lead-header slds-page-header slds-page-header_record-home slds-theme_default slds-box slds-box_small slds-m-bottom_medium">
                            <div class="slds-page-header__row">
                                <div class="slds-page-header__col-title">
                                    <div class="slds-media slds-media_center">
                                        <div class="slds-media__body">
                                            <div class="slds-page-header__name">
                                                <div class="slds-page-header__name-title">
                                                    <h1 class="slds-page-header__title slds-truncate slds-align-middle">
                                                        <a href="{!'/lightning/r/Lead__c/' + v.selectedLead.Id + '/view'}" target="_blank" class="slds-text-heading_medium" title="{!v.selectedLead.Name__c}">
                                                            {!v.selectedLead.Name__c}
                                                        </a>
                                                    </h1>
                                                </div>
                                            </div>
                                            <div class="slds-page-header__row slds-m-top_small">
                                                <div class="slds-page-header__col-meta">
                                                    <div class="detail-item slds-p-vertical_xx-small">
                                                        <div class="slds-text-title slds-text-color_weak slds-truncate">Lead Status</div>
                                                        <div class="slds-text-body_regular slds-truncate slds-m-top_xx-small">
                                                            {!v.selectedLead.Lead_Status__c}
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    
                                        <div class="slds-media__figure slds-m-right_medium">
                                            <lightning:button variant="base" iconName="utility:chevronleft" iconPosition="left" label="Back" title="Go back to leads list" onclick="{!c.onGobackToList}" class="back-nav-button"/>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            
                            <!-- Details Row -->
                            <div class="slds-page-header__row slds-page-header__row_gutters slds-m-top_medium">
                                <div class="slds-page-header__col-details">
                                    <div class="slds-grid slds-wrap slds-gutters">
                                        <!-- Column 1 -->
                                        <div class="slds-col slds-size_6-of-12">
                                            <div class="slds-grid slds-wrap slds-gutters_xx-small">
                                                <div class="slds-col slds-size_1-of-2">
                                                    <div class="detail-item slds-p-vertical_xx-small">
                                                        <div class="slds-text-title slds-text-color_weak slds-truncate">Phone</div>
                                                        <div class="slds-text-body_regular slds-truncate slds-m-top_xx-small">
                                                            {!v.selectedLead.Phone__c}
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="slds-col slds-size_1-of-2">
                                                    <div class="detail-item slds-p-vertical_xx-small">
                                                        <div class="slds-text-title slds-text-color_weak slds-truncate">Email</div>
                                                        <div class="slds-text-body_regular slds-truncate slds-m-top_xx-small">
                                                            {!v.selectedLead.Email__c}
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="slds-col slds-size_1-of-2">
                                                    <div class="detail-item slds-p-vertical_xx-small">
                                                        <div class="slds-text-title slds-text-color_weak slds-truncate">Primary Lead Source</div>
                                                        <div class="slds-text-body_regular slds-truncate slds-m-top_xx-small">
                                                            {!v.selectedLead.Primary_Source__c}
                                                        </div>
                                                    </div>
                                                </div>
                                                <!-- commented out for later use - Medium replaced with Primary Sub Source
                                                <div class="slds-col slds-size_1-of-2">
                                                    <div class="detail-item slds-p-vertical_xx-small">
                                                        <div class="slds-text-title slds-text-color_weak slds-truncate">Medium</div>
                                                        <div class="slds-text-body_regular slds-truncate slds-m-top_xx-small">
                                                            {!v.selectedLead.Medium__c}
                                                        </div>
                                                    </div>
                                                </div>
                                                -->
                                                <div class="slds-col slds-size_1-of-2">
                                                    <div class="detail-item slds-p-vertical_xx-small">
                                                        <div class="slds-text-title slds-text-color_weak slds-truncate">Primary Sub Source</div>
                                                        <div class="slds-text-body_regular slds-truncate slds-m-top_xx-small">
                                                            {!v.selectedLead.Primary_Sub_Source__c}
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                        
                                        <!-- Column 2 -->
                                        <div class="slds-col slds-size_6-of-12">
                                            <div class="slds-grid slds-wrap slds-gutters_xx-small">
                                                <div class="slds-col slds-size_1-of-2">
                                                    <div class="detail-item slds-p-vertical_xx-small">
                                                        <div class="slds-text-title slds-text-color_weak slds-truncate">Record Type</div>
                                                        <div class="slds-text-body_regular slds-truncate slds-m-top_xx-small">
                                                            {!v.recordTypeName}
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="slds-col slds-size_1-of-2">
                                                    <div class="detail-item slds-p-vertical_xx-small">
                                                        <div class="slds-text-title slds-text-color_weak slds-truncate">Project Name</div>
                                                        <div class="slds-text-body_regular slds-truncate slds-m-top_xx-small">
                                                            <lightning:icon iconName="standard:location" size="x-small" class="slds-m-right_xx-small"/>
                                                            {!v.selectedLead.Allocated_Project__c}
                                                        </div>
                                                    </div>
                                                </div>
                                                <!-- commented out for later use - Source Type replaced with Lead Type
                                                <div class="slds-col slds-size_1-of-2">
                                                    <div class="detail-item slds-p-vertical_xx-small">
                                                        <div class="slds-text-title slds-text-color_weak slds-truncate">Source Type</div>
                                                        <div class="slds-text-body_regular slds-truncate slds-m-top_xx-small">
                                                            {!v.selectedLead.Source_Type__c}
                                                        </div>
                                                    </div>
                                                </div>
                                                -->
                                                <div class="slds-col slds-size_1-of-2">
                                                    <div class="detail-item slds-p-vertical_xx-small">
                                                        <div class="slds-text-title slds-text-color_weak slds-truncate">Lead Type</div>
                                                        <div class="slds-text-body_regular slds-truncate slds-m-top_xx-small">
                                                            {!v.selectedLead.Lead_Type__c}
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="slds-col slds-size_1-of-2">
                                                    <div class="detail-item slds-p-vertical_xx-small">
                                                        <div class="slds-text-title slds-text-color_weak slds-truncate">Owner</div>
                                                        <div class="slds-text-body_regular slds-truncate slds-m-top_xx-small">
                                                            <lightning:icon iconName="standard:user" size="x-small" class="slds-m-right_xx-small"/>
                                                            {!v.selectedLead.Owner.Name}
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        
                        <!-- Site Visits Card -->
                        <article class="slds-card slds-box slds-box_small slds-m-bottom_medium">
                            <div class="slds-card__header slds-grid slds-theme_shade slds-p-vertical_small slds-p-horizontal_medium">
                                <header class="slds-media slds-media_center slds-has-flexi-truncate">
                                    <div class="slds-media__figure">
                                        <div class="slds-icon_container slds-icon-standard-task custom-icon-container" title="Site Visit">
                                            <lightning:icon iconName="custom:custom57" alternativeText="Site Visit" title="Site Visit" size="small"/>
                                        </div>
                                    </div>
                                    <div class="slds-media__body">
                                        <h2 class="slds-card__header-title">
                                            <span class="slds-text-heading_small">Site Visits</span>
                                        </h2>
                                        <p class="slds-text-body_small slds-text-color_weak slds-m-top_xx-small">Manage and schedule site visits for this lead</p>
                                    </div>
                                </header>
                                <div class="slds-media__figure slds-media__figure_reverse">
                                    <lightning:button variant="brand" label="New Site Visit" iconName="utility:add" iconPosition="left" onclick="{!c.openSVCompModal}"/>
                                </div>
                            </div>
                            
                            <div class="slds-card__body slds-card__body_inner slds-theme_default slds-p-horizontal_medium slds-p-vertical_medium">
                                
                            
                        
                        <!--
                        <div class="slds-grid">
                            <div class="slds-col slds-order_1 slds-large-order_2 size_1-of-1 slds-medium-size_6-of-12 slds-large-size_5-of-12">
                                <ol class="slds-setup-assistant">
                                    <aura:if isTrue="{!empty(v.scheduledSiteVisit)}">
                                        <li class="slds-setup-assistant__item slds-p-around_medium border-full">
                                            <article class="slds-setup-assistant__step">
                                                <div class="slds-setup-assistant__step-summary">
                                                    <div class="slds-media">
                                                        <div class="slds-media__body slds-m-top_x-small">
                                                            <div class="slds-media">
                                                                <div class="slds-setup-assistant__step-summary-content slds-media__body slds-m-right_small">
                                                                    <h3 class="slds-setup-assistant__step-summary-title slds-text-heading_small">Create New Site Visit</h3>
