<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>End_Date</fullName>
    <active>true</active>
    <errorConditionFormula>NOT(ISBLANK(End_Date__c)) &amp;&amp;
End_Date__c &lt;= TODAY()</errorConditionFormula>
    <errorMessage>End Date must be a future date.</errorMessage>
</ValidationRule>
