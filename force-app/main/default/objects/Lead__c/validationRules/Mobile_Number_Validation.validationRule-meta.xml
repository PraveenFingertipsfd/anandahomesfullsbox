<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Mobile_Number_Validation</fullName>
    <active>true</active>
    <errorConditionFormula>OR(
    AND(NOT(ISBLANK(Phone__c)), NOT(REGEX(Phone__c , &quot;^[0-9]{10}$&quot;))),
    AND(NOT(ISBLANK(Secondary_Phone__c)), NOT(REGEX(Secondary_Phone__c , &quot;^[0-9]{10}$&quot;)))
)</errorConditionFormula>
    <errorMessage>Phone Number and Secondary Phone Number must contain exactly 10 digits and only numbers.</errorMessage>
</ValidationRule>
