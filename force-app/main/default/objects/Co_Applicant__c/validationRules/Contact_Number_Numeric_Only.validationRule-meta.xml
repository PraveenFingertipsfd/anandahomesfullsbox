<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Contact_Number_Numeric_Only</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
  OR(ISNEW(), ISCHANGED(Mobile__c)),
  NOT(ISBLANK(Contact_Number__c)),
  NOT(REGEX(Contact_Number__c, &quot;[0-9]+&quot;))
)</errorConditionFormula>
    <errorDisplayField>Contact_Number__c</errorDisplayField>
    <errorMessage>Mobile number can contain numeric values only.</errorMessage>
</ValidationRule>
