<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>PAN_Number_Pattern</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
  OR(ISNEW(), ISCHANGED(PAN_Number__c)),
  NOT(ISBLANK(PAN_Number__c)),
  NOT(REGEX(PAN_Number__c, &quot;[A-Za-z]{5}[0-9]{4}[A-Za-z]{1}&quot;))
)</errorConditionFormula>
    <errorDisplayField>PAN_Number__c</errorDisplayField>
    <errorMessage>PAN must be in the format AAAAA9999A (5 letters, 4 digits, 1 letter).</errorMessage>
</ValidationRule>
