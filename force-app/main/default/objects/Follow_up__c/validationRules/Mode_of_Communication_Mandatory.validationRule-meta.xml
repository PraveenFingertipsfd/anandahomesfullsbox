<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Mode_of_Communication_Mandatory</fullName>
    <active>false</active>
    <errorConditionFormula>AND(
ISPICKVAL(Status__c, &quot;Completed&quot;),
ISBLANK(TEXT(Mode_of_Communication__c))
)</errorConditionFormula>
    <errorDisplayField>Mode_of_Communication__c</errorDisplayField>
    <errorMessage>Mode of communication is Mandatory.</errorMessage>
</ValidationRule>
