<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Call_Duration_Mandatory</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
    ISPICKVAL(Status__c, &quot;Completed&quot;),
    ISBLANK(Call_Duration_In_Mins__c)
)</errorConditionFormula>
    <errorMessage>Call Duration must be filled when Status is Completed.</errorMessage>
</ValidationRule>
