<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Validate_Mobile_Number</fullName>
    <active>true</active>
    <errorConditionFormula>NOT(REGEX(Mobile_Number__c, &quot;^[0-9]{10}$&quot;))</errorConditionFormula>
    <errorDisplayField>Mobile_Number__c</errorDisplayField>
    <errorMessage>Please enter a valid 10-digit mobile number (numbers only).</errorMessage>
</ValidationRule>
