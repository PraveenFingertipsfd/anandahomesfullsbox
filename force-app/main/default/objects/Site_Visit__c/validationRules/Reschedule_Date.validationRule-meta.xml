<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Reschedule_Date</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
        ISPICKVAL(Status__c, &quot;Rescheduled&quot;),
        Date__c &lt; NOW()
    )</errorConditionFormula>
    <errorDisplayField>Date__c</errorDisplayField>
    <errorMessage>Please Select Reschedule Date and Time that is in the future.</errorMessage>
</ValidationRule>
