<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Reschedule_Validation</fullName>
    <active>false</active>
    <errorConditionFormula>AND(
ISCHANGED(Status__c),
ISPICKVAL(PRIORVALUE(Status__c), &quot;GRE Verified&quot;),
ISPICKVAL(Status__c, &quot;Rescheduled&quot;)
)</errorConditionFormula>
    <errorMessage>Changing status from GRE verified to Reschedule and Cancelled is not allowed.</errorMessage>
</ValidationRule>
