<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Site_Visit_Completed_Date</fullName>
    <active>false</active>
    <errorConditionFormula>AND(
    ISPICKVAL(Status__c , &quot;Completed&quot;),
    ISBLANK(SV_Completed_Date_Time__c)
)</errorConditionFormula>
    <errorMessage>Please fill &apos;Completed Date &amp; Time&apos; before marking the Site Visit as Completed</errorMessage>
</ValidationRule>
