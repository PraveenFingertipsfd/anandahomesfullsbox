                <tr><td class="label">BRANCH CITY</td><td>HYDERABAD</td></tr>
            </table>
        </li>

        <li>That the builder agrees that the loan GST amount may be credited to the
        below mentioned account
            <table class="detail">
                <tr><td class="label">NAME OF ACCOUNT HOLDER</td><td>ANANDA HOMES</td></tr>
                <tr><td class="label">BANK ACCOUNT NUMBER</td><td>322205002425</td></tr>
